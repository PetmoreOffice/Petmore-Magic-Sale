{
	# ไม่ขอใบรับรองเอง: ในวง LAN ใช้ http ส่วนคนข้างนอกได้ https จาก Cloudflare Tunnel
	auto_https off
	admin off
}

(app) {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv
		# หน้าเว็บแบบ SPA: ทุกเส้นทางที่ไม่ใช่ไฟล์ ส่ง index.html
		try_files {path} /index.html
		file_server
		# ไฟล์ที่มีเลข hash ในชื่อ เก็บแคชได้นาน, index.html/sw.js ต้องถามใหม่ทุกครั้ง
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
	}
}

# ทางเข้าในวง LAN (Handheld, คอมในบริษัท) เปิดพอร์ต 80 ของเครื่อง
# ลบหัว CF-Connecting-IP ที่คนในวงอาจปลอมมา API จะได้นับคำขอตาม IP จริง
:80 {
	request_header -CF-Connecting-IP
	import app
}

# ทางเข้าของ Cloudflare Tunnel เท่านั้น (ไม่เปิดออกนอกเครื่อง) Cloudflare ใส่ CF-Connecting-IP ให้เอง
:8080 {
	import app
}
