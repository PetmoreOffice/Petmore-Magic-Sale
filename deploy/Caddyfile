{
	# ไม่ขอใบรับรองเอง: ในวง LAN ใช้ http ส่วนคนข้างนอกได้ https จาก Cloudflare Tunnel
	auto_https off
	admin off
}

(app) {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:3000
	}
	# ไฟล์ที่มีเลข hash ในชื่อ เก็บแคชได้นาน ไม่เจอ = 404 จริง (ห้ามตกไป index.html แล้วถูกแคชเป็นปี)
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		# หน้าเว็บแบบ SPA: ทุกเส้นทางที่ไม่ใช่ไฟล์ ส่ง index.html
		# ทุกอย่างนอก /assets ต้องถามเซิร์ฟเวอร์ใหม่ทุกครั้ง (index.html, sw.js, /orders, /check ...) อัปเดตแล้วเห็นทันที
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# ทางเข้าในวง LAN (Handheld, คอมในบริษัท) เปิดพอร์ต 80 ของเครื่อง
# ลบหัว CF-Connecting-IP ที่คนในวงอาจปลอมมา API จะได้นับคำขอตาม IP จริง
:80 {
	request_header -CF-Connecting-IP
	import app
}

# ทางเข้าของ Cloudflare Tunnel เท่านั้น (ไม่เปิดออกนอกเครื่อง) Cloudflare ใส่ CF-Connecting-IP ให้เอง
:8080 {
	import app
}
