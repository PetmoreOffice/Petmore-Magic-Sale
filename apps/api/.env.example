# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)

# PostgreSQL ของระบบ (docker-compose.yml)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/petmore_wms
PORT=3000

# บัญชีผู้ดูแลคนแรก (npm run seed) รหัสผ่านอย่างน้อย 8 ตัว
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# SQL Server บริษัท (อ่านอย่างเดียว)
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=
MSSQL_TRUST_SERVER_CERTIFICATE=
# SQL Server 2014 รองรับแค่ TLS 1.0 ต้องตั้งเป็น TLSv1
MSSQL_TLS_MIN_VERSION=
MSSQL_PRODUCT_QUERY=
MSSQL_PACK_QUERY=
SYNC_CRON=
